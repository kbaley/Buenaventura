@using ApexCharts
@using ChartOptions = Buenaventura.Client.Services.ChartOptions
<MudPaper Elevation="1" Class="pa-4" Height="@paperHeight">
    @if (IsLoading)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="20px" Width="30%"/>
            </MudItem>
            <MudItem xs="2">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@skeletonHeight" Width="100%"/>
            </MudItem>
            <MudItem xs="10">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@skeletonHeight" Width="100%"/>
            </MudItem>
            <MudItem xs="2"/>
            <MudItem xs="10">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="20px" Width="100%"/>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <ApexChart TItem="ReportDataPoint"
                   Options="investmentsChartOptions"
                   Height="@(Height - 50)"
                   Title="@Title">
            <ApexPointSeries
                TItem="ReportDataPoint"
                Items="ChartData"
                Name="@SeriesName"
                XValue="@(e => e.Label)"
                YValue="@(e => e.Value)"
                SeriesType="SeriesType.Line"/>
            @if (ComparisonData.Any())
            {
                <ApexPointSeries
                    TItem="ReportDataPoint"
                    Items="ComparisonData"
                    Name="@ComparisonSeriesName"
                    XValue="@(e => e.Label)"
                    YValue="@(e => e.Value)"
                    SeriesType="SeriesType.Line"/>
            }
            @if (TrendLine.Any())
            {
                <ApexPointSeries
                    TItem="ReportDataPoint"
                    Items="TrendLine"
                    Name="Trend Line"
                    XValue="@(e => e.Label)"
                    YValue="@(e => e.Value)"
                    SeriesType="SeriesType.Line"/>
            }
        </ApexChart>
    }
</MudPaper>

@code {

    [Parameter] public bool IsLoading { get; set; } = true;
    [Parameter] public IEnumerable<ReportDataPoint> ChartData { get; set; } = [];
    [Parameter] public IEnumerable<ReportDataPoint> ComparisonData { get; set; } = [];
    [Parameter] public IEnumerable<ReportDataPoint> TrendLine { get; set; } = [];
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SeriesName { get; set; } = "Value";
    [Parameter] public string ComparisonSeriesName { get; set; } = "Previous Period";
    [Parameter] public bool FitYAxisToData { get; set; }
    [Parameter] public int Height { get; set; } = 300;

    private string paperHeight => $"{Height}px";
    private string skeletonHeight => $"{Height - 115}px";

    private readonly ApexChartOptions<ReportDataPoint> investmentsChartOptions = ChartOptions.GetDefaultOptions<ReportDataPoint>();

    protected override void OnParametersSet()
    {
        var axis = investmentsChartOptions.Yaxis[0];
        axis.Min = null;
        axis.Max = null;
        if (!FitYAxisToData)
            return;

        var values = ChartData.Concat(ComparisonData).Concat(TrendLine).Select(p => p.Value).ToList();
        if (values.Count == 0)
            return;

        var min = values.Min();
        var max = values.Max();
        // Pad the range, including flat series, without anchoring the axis at zero.
        var padding = max == min ? Math.Max(Math.Abs(min) * 0.01m, 1m) : (max - min) * 0.1m;
        axis.Min = min - padding;
        axis.Max = max + padding;
        axis.ForceNiceScale = false;
    }

}